{
  "name": "W2: Deduplicate & Score",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      },
      "name": "Trigger Post-Research",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.research_signals WHERE processed = false;"
      },
      "name": "Fetch Unprocessed Signals",
      "type": "n8n-nodes-base.supabase",
      "position": [450, 300]
    },
    {
      "parameters": {
        "model": "gpt-4",
        "messages": {
          "messageValues": [
            {
              "message": "You are a content scoring AI. Evaluate these signals against the Brand Profile: Code x Craft x Contemporary Design. Output JSON with scores (0-100) for US relevance, UK relevance, freshness, and Pranavi alignment."
            }
          ]
        }
      },
      "name": "OpenAI Scorer",
      "type": "n8n-nodes-base.openAi",
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "topic_scores",
        "dataMode": "define",
        "values": {
          "total_opportunity_score": "={{$json.score.total}}"
        }
      },
      "name": "Save Scores",
      "type": "n8n-nodes-base.supabase",
      "position": [850, 300]
    }
  ],
  "connections": {
    "Trigger Post-Research": {
      "main": [
        [{"node": "Fetch Unprocessed Signals", "type": "main", "index": 0}]
      ]
    },
    "Fetch Unprocessed Signals": {
      "main": [
        [{"node": "OpenAI Scorer", "type": "main", "index": 0}]
      ]
    },
    "OpenAI Scorer": {
      "main": [
        [{"node": "Save Scores", "type": "main", "index": 0}]
      ]
    }
  }
}
