# Supabase Credentials (Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# n8n Webhook URLs (set after n8n is running — never include API keys here)
NEXT_PUBLIC_N8N_WEBHOOK_GENERATE_DRAFT=http://localhost:5678/webhook/generate-draft
NEXT_PUBLIC_N8N_WEBHOOK_APPROVE=http://localhost:5678/webhook/approve-draft

# AI Provider (server-side only — never NEXT_PUBLIC_)
# Options: openai | ollama | gemini | groq
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-key-here

# Supabase Service Role (server-side only — n8n uses this, NEVER in browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Agent Reach (optional)
AGENT_REACH_CONFIG_PATH=./agent-reach/config/sources.json

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
